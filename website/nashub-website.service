[Unit]
Description=NAS Hub (Flask via gunicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/srv/website

ExecStart=/home/nas/.venv/bin/gunicorn -w 1 -b 0.0.0.0:80 app:app

Restart=on-failure
RestartSec=5

Environment="SERVER_IP=192.168.1.230"
Environment="SERVER_NAME=nas.local"
Environment="BASE_URL=http://192.168.1.230"
Environment="DRIVE_STATUS_DATA_DIR=/home/nas/data/drive-status"

[Install]
WantedBy=multi-user.target
